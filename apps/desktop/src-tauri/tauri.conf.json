{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Touhou Peach Reader",
  "version": "0.1.7",
  "identifier": "com.touhou.peachreader",
  "build": {
    "beforeDevCommand": "corepack pnpm --filter @tpr/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm --filter @tpr/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Touhou Peach Reader",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://github.com https://codeload.github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com https://*.githubusercontent.com; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
